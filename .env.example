# Network
PORT=3000

# Login/session
SITE_PASSWORD=STRICT
SESSION_SECRET=replace_with_secure_random_secret

# Persistence (required for production persistence)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Game and feature toggles (forward-compatible)
GAME_ENABLED=true
GAME_START_BALANCE=1000
GAME_PRICE_TICK_SECONDS=300

# Licensing (forward-compatible)
LICENSE_MODE=off
LICENSE_KEY=

# Nostalgia video IDs (optional)
NOSTALGIA_PS1_YOUTUBE_ID=your_youtube_video_id_here
NOSTALGIA_PS2_YOUTUBE_ID=your_youtube_video_id_here
NOSTALGIA_GAMECUBE_YOUTUBE_ID=your_youtube_video_id_here
NOSTALGIA_WIISSBB_YOUTUBE_ID=your_youtube_video_id_here

# CoinGecko (crypto prices). Works without a key, but the keyless public limit
# is tight enough that switching chart ranges quickly can hit a 429. A free
# Demo key from https://www.coingecko.com/en/developers/dashboard removes that.
# Attribution ("Powered by CoinGecko") is mandatory either way and is rendered
# on the stocks page.
COINGECKO_API_KEY=

# Minimum gap in ms between outbound CoinGecko calls (default 1500).
# Lower it when a Demo key is configured.
COINGECKO_MIN_INTERVAL_MS=

# Public address of this site, used in the shareable daily result. Left empty
# the share text simply omits the link rather than pointing at localhost.
PUBLIC_URL=

# Discord sign-in (optional). Without these the site runs guests-only, exactly
# as before. Create an application at https://discord.com/developers, add
# <your-origin>/auth/discord/callback as a redirect URI, and copy the OAuth2
# client ID and secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only needed when the callback URL cannot be derived from the request, e.g.
# behind a proxy that rewrites the host. Must match the portal byte for byte.
DISCORD_REDIRECT_URI=

# Delete player accounts dormant this many months (GDPR storage limitation).
# Default 24, which is what public/datenschutz.html states — change both or
# neither. Set to 0 to switch deletion off. Values below 6 are refused and fall
# back to the default.
ACCOUNT_RETENTION_MONTHS=24

# Admin password for privileged socket actions
ADMIN_PASSWORD=

# Token for the /admin/logs ring-buffer endpoint (optional; endpoint is disabled without it)
LOGS_TOKEN=

# Self-ping URL to keep free-tier hosting awake (optional; RENDER_EXTERNAL_URL is used automatically on Render)
KEEP_ALIVE_URL=
